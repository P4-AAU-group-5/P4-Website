<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= title %></title>
  <link rel="stylesheet" href="/stylesheets/style.css" />
</head>

<body>
<main class="app-shell">
  <section class="top-bar">
    <output id="timeDisplay">00:00</output>

    <div class="time-bar" id="timeBar">
      <div class="time-indicator" id="timeIndicator"></div>
    </div>
  </section>

  <section class="content">
    <div class="house">
      <div class="room left-room">
        <div class="lamp-wrapper">
          <div class="lamp-cord"></div>
          <div class="device lamp off" id="lamp"></div>
        </div>

        <div class="device door unlocked" id="door">
          <div class="door-knob"></div>
        </div>
      </div>

      <div class="room right-room"></div>

      <div class="room-divider"></div>
    </div>

    <aside class="control-panel">
      <h2>Control Panel</h2>

      <div class="panel-card">
        <h3>Sensors</h3>

        <div class="control-group">
          <div class="sensor-line">
            <span>Temperature:</span>
            <strong id="temperatureValue">21°C</strong>
          </div>

          <input
                  type="range"
                  id="temperature"
                  min="10"
                  max="30"
                  value="21"
          />
        </div>

        <div class="control-group">
          <div class="sensor-line">
            <span>Light:</span>
            <strong id="light">Night</strong>
          </div>
        </div>
      </div>

      <div class="panel-card">
        <h3>Devices</h3>

        <div class="control-row">
          <span>Lamp</span>
          <button class="toggle-btn" data-device="lamp">Off</button>
        </div>

        <div class="control-row">
          <span>Door</span>
          <button class="toggle-btn" data-device="door">Unlocked</button>
        </div>
      </div>
    </aside>
  </section>
</main>

<script>
  const timeDisplay = document.querySelector("#timeDisplay");
  const timeBar = document.querySelector("#timeBar");
  const timeIndicator = document.querySelector("#timeIndicator");

  const lamp = document.querySelector("#lamp");
  const door = document.querySelector("#door");

  const lampToggle = document.querySelector('[data-device="lamp"]');
  const doorToggle = document.querySelector('[data-device="door"]');

  const temperatureSlider = document.querySelector("#temperature");
  const temperatureValue = document.querySelector("#temperatureValue");
  const lightDisplay = document.querySelector("#light");

  let currentMinutes = 0;

  const sensorState = {
    time: 0,
    temperature: 21,
    light: "night"
  };

  /*
    Device booleans:
    lamp: false = off, true = on
    door: false = unlocked, true = locked
  */
  const deviceState = {
    lamp: false,
    door: false
  };

  function updateTimeDisplay() {
    const hours = Math.floor(currentMinutes / 60);
    const minutes = currentMinutes % 60;

    timeDisplay.textContent =
            `${hours.toString().padStart(2, "0")}:${minutes
                    .toString()
                    .padStart(2, "0")}`;

    const percent = currentMinutes / 1440;
    timeIndicator.style.left = `${percent * 100}%`;

    sensorState.time = currentMinutes;
  }

  function updateLightSensor() {
    const hour = currentMinutes / 60;
    let lightState = "night";

    if (hour >= 6 && hour < 18) {
      lightState = "day";
    }

    sensorState.light = lightState;
    lightDisplay.textContent =
            lightState.charAt(0).toUpperCase() + lightState.slice(1);
  }

  timeBar.addEventListener("click", (e) => {
    const rect = timeBar.getBoundingClientRect();
    const x = e.clientX - rect.left;
    const percent = x / rect.width;

    currentMinutes = Math.round((percent * 1440) / 15) * 15;

    if (currentMinutes >= 1440) {
      currentMinutes = 1435;
    }

    updateTimeDisplay();
    updateLightSensor();
  });

  temperatureSlider.addEventListener("input", () => {
    const value = Number(temperatureSlider.value);

    sensorState.temperature = value;
    temperatureValue.textContent = `${value}°C`;
  });

  function updateDevices() {
    // Lamp: true = on, false = off
    lamp.classList.remove("on", "off");

    if (deviceState.lamp) {
      lamp.classList.add("on");
      lampToggle.textContent = "On";
    } else {
      lamp.classList.add("off");
      lampToggle.textContent = "Off";
    }

    // Door: true = locked, false = unlocked
    door.classList.remove("locked", "unlocked");

    if (deviceState.door) {
      door.classList.add("locked");
      doorToggle.textContent = "Locked";
    } else {
      door.classList.add("unlocked");
      doorToggle.textContent = "Unlocked";
    }
  }

  lampToggle.addEventListener("click", () => {
    deviceState.lamp = !deviceState.lamp;
    updateDevices();
  });

  doorToggle.addEventListener("click", () => {
    deviceState.door = !deviceState.door;
    updateDevices();
  });

  async function fetchState() {
    const response = await fetch("/DSL", {
      method: "POST",
      headers: {
        "Content-Type": "application/json"
      },
      body: JSON.stringify({
        sensorState,
        deviceState
      })
    });

    const newState = await response.json();

    if (newState.deviceState) {
      Object.assign(deviceState, newState.deviceState);
      updateDevices();
    }
  }

  async function loop() {
    await fetchState();
    setTimeout(loop, 1000);
  }

  updateTimeDisplay();
  updateLightSensor();
  updateDevices();

  // Uncomment this when you want the frontend to sync with /DSL continuously.
  // loop();
</script>
</body>
</html>